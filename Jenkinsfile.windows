
pipeline {
    agent any

    options {
        timestamps()
    }

    parameters {
        booleanParam(
            name: 'RUN_REPLAY',
            defaultValue: false,
            description: 'Run the policy-replay experiment'
        )

        booleanParam(
            name: 'BUILD_DOCKER',
            defaultValue: false,
            description: 'Build the Docker image'
        )

        booleanParam(
            name: 'RUN_DAST',
            defaultValue: false,
            description: 'Run OWASP ZAP security scan'
        )

        string(
            name: 'DAST_TARGET_URL',
            defaultValue: 'http://host.docker.internal:5000',
            description: 'Running AQI application URL'
        )
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Tools') {
            steps {
                bat 'python --version'
            }
        }

        stage('Install') {
            steps {
                bat '''
                if not exist .venv (
                    python -m venv .venv
                )

                .venv\\Scripts\\python -m pip install -q -r requirements.txt
                .venv\\Scripts\\python -m pip install -q bandit pip-audit
                '''
            }
        }

        // SAST - Static Code Analysis
        stage('SAST - Static Code Analysis') {
            steps {
                bat 'if not exist results mkdir results'

                script {
                    def status = bat(
                        returnStatus: true,
                        script: '''
                        .venv\\Scripts\\python -m bandit ^
                        -r . ^
                        -x .venv,venv,tests,.git,results,__pycache__ ^
                        -f json ^
                        -o results/bandit-report.json
                        '''
                    )

                    if (status == 0) {
                        echo 'Bandit scan completed without reported findings.'
                    } else {
                        echo "Bandit returned exit code ${status}. Review the security report."
                    }
                }
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'results/bandit-report.json',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        // SCA - Dependency Vulnerability Scanning
        stage('SCA - Dependency Vulnerability Scanning') {
            steps {
                script {
                    def status = bat(
                        returnStatus: true,
                        script: '''
                        .venv\\Scripts\\python -m pip_audit ^
                        -r requirements.txt ^
                        -f json ^
                        -o results/pip-audit-report.json
                        '''
                    )

                    if (status == 0) {
                        echo 'Dependency scan completed without reported vulnerabilities.'
                    } else {
                        echo "pip-audit returned exit code ${status}. Review the security report."
                    }
                }
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'results/pip-audit-report.json',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        // Automated Testing
        stage('Test') {
            steps {
                bat '.venv\\Scripts\\python -m pytest -q --junitxml=test-results.xml'
            }

            post {
                always {
                    junit(
                        allowEmptyResults: true,
                        testResults: 'test-results.xml'
                    )
                }
            }
        }

        // AQI Replay Experiment
        stage('Replay Experiment') {
            when {
                expression {
                    params.RUN_REPLAY
                }
            }

            steps {
                bat '.venv\\Scripts\\python driftguard.py --out results'

                archiveArtifacts(
                    artifacts: 'results/**',
                    fingerprint: true
                )
            }
        }

        // Docker Image Build
        stage('Build Image') {
            when {
                expression {
                    params.BUILD_DOCKER
                }
            }

            steps {
                bat 'docker build -t driftguard-aqi:%BUILD_NUMBER% .'
            }
        }

        // DAST - Dynamic Application Security Testing
        stage('DAST - OWASP ZAP') {
            when {
                expression {
                    params.RUN_DAST
                }
            }

            steps {
                script {
                    def status = bat(
                        returnStatus: true,
                        script: '''
                        docker run --rm ^
                        -v "%WORKSPACE%:/zap/wrk/:rw" ^
                        zaproxy/zap-stable ^
                        zap-baseline.py ^
                        -t "%DAST_TARGET_URL%" ^
                        -J zap-report.json
                        '''
                    )

                    if (status == 0) {
                        echo 'OWASP ZAP scan completed.'
                    } else {
                        echo "OWASP ZAP returned exit code ${status}. Review its report and console output."
                    }
                }
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'zap-report.json',
                        allowEmptyArchive: true
                    )
                }
            }
        }
    }
}

