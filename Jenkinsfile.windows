
pipeline {
    agent any

    options {
        timestamps()
    }

    parameters {
        booleanParam(
            name: 'RUN_REPLAY',
            defaultValue: false,
            description: 'Run AQI replay experiment'
        )

        booleanParam(
            name: 'BUILD_DOCKER',
            defaultValue: false,
            description: 'Build Docker image'
        )

        booleanParam(
            name: 'RUN_DAST',
            defaultValue: false,
            description: 'Run OWASP ZAP DAST scan'
        )

        string(
            name: 'DAST_TARGET_URL',
            defaultValue: 'http://host.docker.internal:5000',
            description: 'Running AQI application URL'
        )
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Tools') {
            steps {
                bat 'python --version'
            }
        }

        stage('Install') {
            steps {
                bat '''
                python -m venv .venv
                .venv\\Scripts\\python -m pip install -q -r requirements.txt
                .venv\\Scripts\\python -m pip install -q bandit pip-audit
                '''
            }
        }

        stage('SAST - Static Code Analysis') {
            steps {
                bat 'if not exist results mkdir results'

                bat '''
                .venv\\Scripts\\python -m bandit ^
                -r . ^
                -x .venv,venv,tests,.git,results,__pycache__ ^
                -f json ^
                -o results/bandit-report.json
                '''
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'results/bandit-report.json',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('SCA - Dependency Vulnerability Scan') {
            steps {
                bat '''
                .venv\\Scripts\\python -m pip_audit ^
                -r requirements.txt ^
                -f json ^
                -o results/pip-audit-report.json
                '''
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'results/pip-audit-report.json',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('Test') {
            steps {
                bat '.venv\\Scripts\\python -m pytest -q --junitxml=test-results.xml'
            }

            post {
                always {
                    junit(
                        allowEmptyResults: true,
                        testResults: 'test-results.xml'
                    )
                }
            }
        }

        stage('Replay Experiment') {
            when {
                expression {
                    params.RUN_REPLAY
                }
            }

            steps {
                bat '.venv\\Scripts\\python driftguard.py --out results'

                archiveArtifacts(
                    artifacts: 'results/**',
                    fingerprint: true
                )
            }
        }

        stage('Build Image') {
            when {
                expression {
                    params.BUILD_DOCKER
                }
            }

            steps {
                bat 'docker build -t driftguard-aqi:%BUILD_NUMBER% .'
            }
        }

        stage('DAST - OWASP ZAP') {
            when {
                expression {
                    params.RUN_DAST
                }
            }

            steps {
                bat '''
                docker run --rm ^
                -v "%WORKSPACE%:/zap/wrk/:rw" ^
                zaproxy/zap-stable ^
                zap-baseline.py ^
                -t "%DAST_TARGET_URL%" ^
                -J zap-report.json
                '''
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'zap-report.json',
                        allowEmptyArchive: true
                    )
                }
            }
        }
    }
}
